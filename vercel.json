{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/payroll.js": {
      "maxDuration": 300,
      "includeFiles": "{node_modules/stellar-confidential-token-sdk/circuits/**,node_modules/@aztec/bb.js/dest/node/**,node_modules/@noir-lang/*/nodejs/**}"
    },
    "api/cashout.js": {
      "maxDuration": 300,
      "includeFiles": "{node_modules/stellar-confidential-token-sdk/circuits/**,node_modules/@aztec/bb.js/dest/node/**,node_modules/@noir-lang/*/nodejs/**}"
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Cross-Origin-Opener-Policy", "value": "same-origin" },
        { "key": "Cross-Origin-Embedder-Policy", "value": "require-corp" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/.well-known/stellar.toml", "destination": "/api/anchor?__path=.well-known/stellar.toml" },
    { "source": "/auth", "destination": "/api/anchor?__path=auth" },
    { "source": "/sep24/:path*", "destination": "/api/anchor?__path=sep24/:path*" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
