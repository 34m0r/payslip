{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Cross-Origin-Opener-Policy", "value": "same-origin" },
        { "key": "Cross-Origin-Embedder-Policy", "value": "require-corp" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/.well-known/stellar.toml", "destination": "/api/anchor?__path=.well-known/stellar.toml" },
    { "source": "/auth", "destination": "/api/anchor?__path=auth" },
    { "source": "/sep24/:path*", "destination": "/api/anchor?__path=sep24/:path*" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
